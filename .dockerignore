# Everything the image does not need. Keeping these out makes the build
# faster and, for .env, keeps secrets out of the image entirely —
# configuration reaches the container through ECS task environment
# variables instead (see infra/terraform/ecs.tf).
.git
.github
node_modules
.next
npm-debug.log
.env
.env.*
*.md
infra
# public/database and scripts/migrate.mjs are deliberately NOT ignored:
# on AWS the database has no public route, so the only way to load the
# schema is from inside the VPC — i.e. from this image. See
# scripts/migrate.mjs.
scripts/*
!scripts/migrate.mjs
